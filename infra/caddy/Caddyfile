# Trail Peñasagra — entrada web (mismo origen para web, API y archivos).
# Contrato: specs/001-base-proyecto/contracts/rutas-web.md
{
	admin off
}

# Sitios adicionales solo de producción (compose.produccion.yaml monta aquí la redirección de
# www.<dominio>). Sin archivos, la importación no hace nada.
import /etc/caddy/sitios/*.caddy

# Dirección del sitio: `:80` en local; en producción, el dominio (HTTPS automático de Caddy).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# HTTPS obligatorio para el navegador durante un año (sin subdominios). Por HTTP se ignora.
		Strict-Transport-Security "max-age=31536000"
		# CSP (feature 011, research R4): solo la propia web, el mapa de Wikiloc e imágenes https.
		# `?` = valor por defecto: /media conserva la CSP propia que fija la API.
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src https://es.wikiloc.com https://www.wikiloc.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		-Server
	}

	# Subidas: cuerpo máximo 11 MB (la API limita a 10 MB por archivo).
	@subida path /api/upload
	request_body @subida {
		max_size 11MB
	}

	# API y archivos: proxy al servicio FastAPI.
	@backend path /api/* /media/*
	handle @backend {
		reverse_proxy api:8000
	}

	# Errores generados por Caddy en la API, en JSON (el panel muestra el campo `error`).
	handle_errors {
		@demasiado_grande expression `{err.status_code} == 413`
		handle @demasiado_grande {
			header Content-Type "application/json"
			header Cache-Control "no-store"
			respond `{"error":"Máximo 10 MB por archivo."}` 413
		}
		# Si la API no responde (502/503/504): error de servicio.
		@backend_caido path /api/* /media/*
		handle @backend_caido {
			header Content-Type "application/json"
			header Cache-Control "no-store"
			respond `{"error":"El servicio no está disponible. Inténtalo más tarde."}` 503
		}
		# Páginas que no existen (feature 011): 404 real con la página «no encontrada» (noindex).
		@pagina_no_encontrada expression `{err.status_code} == 404`
		handle @pagina_no_encontrada {
			root * /srv
			rewrite * /404.html
			header Cache-Control "no-cache"
			file_server {
				status 404
			}
		}
		# Si la plantilla de detalle falla (API caída), la web carga con los metadatos genéricos y
		# muestra su aviso de respaldo (FR-004 de la feature 011).
		handle {
			root * /srv
			rewrite * /app.html
			header Cache-Control "no-cache"
			file_server {
				status 200
			}
		}
	}

	handle {
		root * /srv

		# Caché: recursos con hash inmutables; el resto se revalida.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@no_assets not path /assets/*
		header @no_assets Cache-Control "no-cache"

		# Vistas de revisión /pantallas: retiradas salvo PANTALLAS=si (decisión P5) → 404 real.
		@pantallas_retiradas {
			path /pantallas /pantallas/*
			not expression `{env.PANTALLAS} == "si"`
		}
		error @pantallas_retiradas 404

		# Panel y vistas de revisión: un único HTML con robots noindex.
		@admin path /admin /admin/*
		rewrite @admin /admin/index.html
		@pantallas path /pantallas /pantallas/*
		rewrite @pantallas /pantallas/index.html

		# Detalles y rutas desconocidas: plantilla que pide los metadatos a la API y responde 404
		# si no existen (specs/011-cierre/contracts/meta-y-rutas.md).
		@plantilla not file {path}/index.html {path}
		rewrite @plantilla /plantilla.html

		# HTML por ruta pública (sin redirección de barra final).
		try_files {path}/index.html {path}

		@es_plantilla path /plantilla.html
		templates @es_plantilla

		file_server
	}
}
