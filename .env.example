# Configuración de ejemplo — Trail Peñasagra
#
# Copia este archivo a `.env` para personalizarlo. El archivo `.env` real no se versiona.
# Los valores de aquí son SOLO de desarrollo local: no son credenciales de producción.
# Compose usa estos mismos valores por defecto si no existe `.env`.

# --- PostgreSQL (servicio `db`, solo red interna) ---
POSTGRES_DB=trail
POSTGRES_USER=trail
POSTGRES_PASSWORD=trail_dev

# Conexión de la API a PostgreSQL (SQLAlchemy + psycopg 3) SOLO al ejecutar la API fuera de
# Compose. Dentro de Compose se construye a partir de POSTGRES_* y este valor se ignora.
DATABASE_URL=postgresql+psycopg://trail:trail_dev@127.0.0.1:5432/trail

# --- Web ---
# Origen público con el que se accede a la web (metadatos OG; comprobación de Origin en 002)
PUBLIC_ORIGIN=http://localhost:8080
# Puerto publicado por la entrada web (Caddy) en local. En producción se publican 80 y 443.
WEB_PORT=8080
# Dirección del sitio para Caddy: `:80` en local; en producción, el dominio (por ejemplo
# xn--trailpeasagra-okb.com), con HTTPS automático. Ver docs/operacion.md.
SITE_ADDRESS=:80
# Vistas de revisión /pantallas (decisión P5): `si` solo para la revisión local; en producción `no`.
PANTALLAS=no

# --- API ---
# desarrollo | produccion  (en producción se desactiva /api/docs)
ENTORNO=desarrollo
# debug | info | warning | error
LOG_LEVEL=info

# --- Administración (feature 002) ---
# Duración absoluta de la sesión del panel (horas)
SESSION_HOURS=8
# Cookies con atributo Secure. En producción SIEMPRE true. Solo para HTTP local: false.
COOKIE_SECURE=false
# Orígenes extra permitidos en escrituras, separados por comas (además de PUBLIC_ORIGIN).
# Ejemplo para `npm run dev`: http://localhost:5173
ORIGENES_PERMITIDOS=
# Límite de accesos fallidos por IP y ventana (minutos)
LOGIN_MAX_INTENTOS=8
LOGIN_VENTANA_MINUTOS=15

# --- Archivos (feature 003) ---
# local (volumen Docker `media`) | s3 (compatible con S3; Cloudflare R2 en producción)
ALMACENAMIENTO=local
MEDIA_DIR=/data/media
# Tamaño máximo por archivo en bytes (10 MB)
UPLOAD_MAX_BYTES=10000000
# Solo con ALMACENAMIENTO=s3. En R2: https://<cuenta>.r2.cloudflarestorage.com y región `auto`.
# Las credenciales reales NUNCA se versionan.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Crear el bucket si falta (solo desarrollo)
S3_CREAR_BUCKET=false
